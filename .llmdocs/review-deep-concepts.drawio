          <mxGeometry x="22" y="33.0" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="j_second_badge" value="x Critical" style="rounded=1;arcSize=50;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="j_second">
          <mxGeometry x="124" y="-26" width="110" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="j_lower" value="&lt;b style=&quot;font-size:15px&quot;&gt;Lower rating wins&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;when the judges disagree, the milder rating stands&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#8a8a8a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1395" y="1880" width="215" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="j_lower_icon" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="j_lower">
          <mxGeometry x="12" y="33.0" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;fontColor=#333333;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="j_issue" target="j_verify">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;fontColor=#333333;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="j_verify" target="j_quote">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;fontColor=#333333;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="j_quote" target="j_crit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;fontColor=#333333;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="j_crit" target="j_second">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;fontColor=#333333;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="j_second" target="j_lower">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e21" value="wrong quote, answer again (up to 3)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c0392b;fontColor=#c0392b;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeWidth=2;dashed=1;endArrow=block;endFill=1;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.2826;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="j_quote" target="j_verify">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="865" y="1830"/>
              <mxPoint x="570" y="1830"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e22" value="no, the verifier's rating stands" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;fontColor=#333333;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="j_crit" target="j_lower">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1045" y="2020"/>
              <mxPoint x="1502" y="2020"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="w6" value="&lt;b style=&quot;font-size:13px&quot;&gt;Why&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Each judge tries to refute an issue instead of confirming it. git checks every quote, so every verdict rests on real code. A blind second model and the lower rating guard against overstated severity.&lt;/span&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffbe6;strokeColor=#b3a369;" vertex="1" parent="p6">
          <mxGeometry x="1620" y="30" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p7" value="" style="rounded=1;arcSize=18;absoluteArcSize=1;html=1;fillColor=#edf6f1;strokeColor=#8cc0a4;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="2110" width="1960" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="p7_num" value="7" style="ellipse;html=1;fillColor=#2e7d4f;strokeColor=none;fontColor=#ffffff;fontSize=20;fontStyle=1;" vertex="1" parent="p7">
          <mxGeometry x="20" y="20" width="38" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="p7_title" value="Isolation and validation" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#333333;fontStyle=1;" vertex="1" parent="p7">
          <mxGeometry x="68" y="18" width="210" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="p7_desc" value="Isolation keeps every model on the pinned code. Checks catch bad answers before they count." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;fontStyle=0;" vertex="1" parent="p7">
          <mxGeometry x="20" y="66" width="250" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="g0" value="&lt;b style=&quot;font-size:15px&quot;&gt;Private copy per reviewer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;each reviewer works in its own copy of the pinned commit. Nothing reads or changes the live repo.&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontSize=12;fillColor=#ffffff;strokeColor=#5a9e7c;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="310" y="2145" width="305" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g0_icon" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="g0">
          <mxGeometry x="12" y="35.0" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="&lt;b style=&quot;font-size:15px&quot;&gt;No steering files&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;CLAUDE.md, AGENTS.md, .claude/, and .llmdocs/ are removed before any model sees the code.&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontSize=12;fillColor=#ffffff;strokeColor=#5a9e7c;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="637" y="2145" width="305" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g1_icon" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="g1">
          <mxGeometry x="12" y="35.0" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="&lt;b style=&quot;font-size:15px&quot;&gt;Locked-down reviewers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;none of the operator's plugins, skills, or MCP servers load. Writes go to one folder.&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontSize=12;fillColor=#ffffff;strokeColor=#5a9e7c;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="964" y="2145" width="305" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g2_icon" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="g2">
          <mxGeometry x="12" y="35.0" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="&lt;b style=&quot;font-size:15px&quot;&gt;Symbol navigation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Serena finds definitions and callers, so a finding cites a real line.&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontSize=12;fillColor=#ffffff;strokeColor=#5a9e7c;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1291" y="2145" width="305" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g3_icon" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="g3">
          <mxGeometry x="12" y="35.0" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="g4" value="&lt;b style=&quot;font-size:15px&quot;&gt;Scripts keep the books&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;counting, merging, and ranking are plain code. AI makes only the judgment calls.&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontSize=12;fillColor=#ffffff;strokeColor=#5a9e7c;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="310" y="2270" width="305" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g4_icon" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="g4">
          <mxGeometry x="12" y="35.0" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="g5" value="&lt;b style=&quot;font-size:15px&quot;&gt;Every answer checked&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;a script validates each AI answer and retries a bad one up to 3 times with the reasons.&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontSize=12;fillColor=#ffffff;strokeColor=#5a9e7c;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="637" y="2270" width="305" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g5_icon" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="g5">
          <mxGeometry x="12" y="35.0" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="g6" value="&lt;b style=&quot;font-size:15px&quot;&gt;Crash-proof runs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;a private database per reviewer, closed stdin, and a watchdog for stuck jobs.&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontSize=12;fillColor=#ffffff;strokeColor=#5a9e7c;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="964" y="2270" width="305" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g6_icon" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="g6">
          <mxGeometry x="12" y="35.0" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="g7" value="&lt;b style=&quot;font-size:15px&quot;&gt;Silence is not success&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;a reviewer that writes nothing is retried, then reported as not reviewed, never as clean.&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontSize=12;fillColor=#ffffff;strokeColor=#5a9e7c;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1291" y="2270" width="305" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g7_icon" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="g7">
          <mxGeometry x="12" y="35.0" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="w7" value="&lt;b style=&quot;font-size:13px&quot;&gt;Why&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Every model sees only the pinned commit, with no project instructions to steer it. Scripts validate every AI answer, and a job that produces nothing is reported as not reviewed.&lt;/span&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffbe6;strokeColor=#b3a369;" vertex="1" parent="p7">
          <mxGeometry x="1620" y="35" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="e23" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;width=14;endWidth=16;endSize=7;fillColor=#FBFFCA;strokeColor=#36393d;exitX=0.0740;exitY=1;exitDx=0;exitDy=0;entryX=0.0740;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="same_time" value="runs at the same time as 2" style="rounded=1;arcSize=50;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="852" width="210" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e24" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;width=14;endWidth=16;endSize=7;fillColor=#FBFFCA;strokeColor=#36393d;exitX=0.0740;exitY=1;exitDx=0;exitDy=0;entryX=0.0740;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e25" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;width=14;endWidth=16;endSize=7;fillColor=#FBFFCA;strokeColor=#36393d;exitX=0.0740;exitY=1;exitDx=0;exitDy=0;entryX=0.0740;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="p5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e26" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;width=14;endWidth=16;endSize=7;fillColor=#FBFFCA;strokeColor=#36393d;exitX=0.0740;exitY=1;exitDx=0;exitDy=0;entryX=0.0740;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="p6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="every_step" value="applies to every step" style="rounded=1;arcSize=50;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="75" y="2072" width="180" height="26" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
